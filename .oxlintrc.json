          "hero-btn-ghost",
          "hero-hint",
          "hero-glow",
          "text-gradient",
          "bg-gradient-hero",
          "border-hairline",
          "border-hairline-strong",
          "border-hairline-inset",
          "divider-hairline",
          "grid-guides",
          "grid-zone",
          "grid-zone__guides",
          "grid-zone__content",
          "grid-plus",
          "bg-admin-card",
          "text-admin-foreground",
          "border-admin-border",
          "text-admin-muted-foreground",
          "text-admin-primary",
          "text-admin-primary-foreground",
          "bg-admin-primary",
          "bg-admin-primary/90",
          "bg-admin-primary/10",
          "bg-admin-sidebar",
          "bg-admin-sidebar-primary/10",
          "bg-admin-popover",
          "text-admin-popover-foreground",
          "text-admin-popover-background",
          "text-admin-sidebar-foreground",
          "text-admin-sidebar-foreground/80",
          "text-admin-sidebar-foreground/70",
          "text-admin-sidebar-foreground/50",
          "border-admin-sidebar-border",
          "border-admin-sidebar-border/50",
          "bg-admin-background",
          "text-admin-destructive",
          "bg-admin-destructive/10",
          "hover:bg-admin-sidebar-primary/10",
          "hover:text-admin-sidebar-primary",
          "hover:bg-admin-accent",
          "hover:text-admin-accent-foreground",
          "hover:bg-admin-destructive/10",
          "bg-admin-accent",
          "bg-admin-accent/50",
          "divide-admin-input",
          "bg-admin-card!",
          "text-admin-foreground!",
          "border-admin-border!",
          "bg-admin-primary!",
          "text-admin-primary-foreground!",
          "bg-admin-muted!",
          "text-admin-muted-foreground!",
          "blur-0",
          "grayscale-0",
          "scout-no-scrollbar",
          "scout-segmented",
          "volume-slider",
          "bar-swap",
          "popover-animated"
        ]
      }
    ],

    "better-tailwindcss/no-restricted-classes": [
      "error",
      {
        "restrict": [
          {
            "pattern": "^(text|tracking|leading|opacity)-\\[(?!(10px|11px|8px|9px|0\\.2em|0\\.3em|0\\.45rem))[^\\]]*\\]$",
            "message": "Arbitrary values like \"$0\" are not allowed for typography/opacity. Use standard Tailwind classes (e.g., text-xs, tracking-wider) or approved design tokens (10px, 11px, 8px, 9px, 0.45rem, 0.2em, 0.3em)."
          },
          {
            "pattern": "^max-w-\\[(?!\\d+ch)[^\\]]*\\]$",
            "message": "Use Tailwind max-w-* utilities or ch units for max-width constraints."
          },
          {
            "pattern": "font-black",
            "message": "font-black (900) is not available in our self-hosted fonts. Use font-bold (700) instead.",
            "fix": "font-bold"
          },
          {
            "pattern": "mix-blend-.*",
            "message": "mix-blend-mode is computationally expensive on mobile. Use opacity or colored overlays instead."
          },
          {
            "pattern": "blur-\\[(1[0-9]{2}|[2-9][0-9]{2})px\\]",
            "message": "Extremely large blurs (>99px) cause major performance drops on mobile GPUs. Use smaller blur values or pre-rendered SVGs."
          }
        ]
      }
    ],

    "sort-imports": "off",
    "capitalized-comments": "off",
    "sort-keys": "off",
    "no-ternary": "off",
    "no-magic-numbers": "off",
    "func-style": "off",
    "curly": "off",
