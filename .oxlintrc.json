  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.spec.ts", "**/*.test.tsx", "**/*.spec.tsx"],
      "rules": {
        "typescript/no-explicit-any": "error",
        "typescript/no-non-null-assertion": "error",
        "typescript/no-unnecessary-type-assertion": "error"
      }
    },
    {
      "files": ["src/components/garage/VehicleCard.tsx"],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    },
    {
      "files": ["src/components/finder/LocationSearchForm.tsx"],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    },
    {
      // Custom vertical volume slider: a native vertical range renders
      // inconsistently across mobile browsers, so the touch popup uses a
      // pointer-driven div with the slider role + full keyboard support.
      "files": ["src/components/radio/PlayerDock.tsx"],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    }
  ],
  "settings": {
    "react": { "version": "19.2.4" },
    "better-tailwindcss": {
      "tags": ["tw", "twMerge", "cn", "clsx"],
      "entryPoint": "src/styles/index.css"
    },
    "jsx-a11y": {
      "components": {
        "Input": "input",
        "Textarea": "textarea",
        "Select": "select",
        "SelectTrigger": "button",
        "Switch": "button",
        "Label": "label"
      }
    }
  }
}
