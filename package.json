{
  "name": "radioscout",
  "version": "0.4.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build:dev": "vp build --mode development",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "fallow": "fallow audit",
    "preview": "wrangler pages dev --port 8788",
    "cap:sync": "npx cap sync",
    "cap:android": "cross-env CAPACITOR_BUILD=1 pnpm exec vp run build && node scripts/strip-sw.mjs && npx cap sync android",
    "cap:open:android": "npx cap open android",
    "cap:version": "node scripts/cap-version.js",
    "fdroid:check": "node scripts/fdroid-check.mjs",
    "obtainium:links": "node scripts/obtainium-links.mjs",
    "ota:publish": "node scripts/publish-ota.mjs",
    "cap:assets": "node scripts/generate-native-assets.mjs",
    "cap:doctor": "npx cap doctor",
    "build:android:apk": "pnpm cap:android && pnpm cap:version && cd android && .\\gradlew.bat assembleDebug",
    "build:android:aab": "pnpm cap:android && pnpm cap:version && cd android && .\\gradlew.bat bundleRelease",
    "build:android:release-like": "pnpm cap:android && pnpm cap:version && cd android && .\\gradlew.bat assembleReleaseTest",
    "android:smoke": "node scripts/android-smoke.mjs",
    "android:smoke:permission": "node scripts/android-permission-smoke.mjs",
    "android:smoke:release": "node scripts/android-release-smoke.mjs",
    "test": "vp test run && playwright test",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "vp test run",
    "test:unit:watch": "vp test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-updater": "^8.52.1",
    "@tanstack/react-hotkeys": "^0.15.1",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "@tanstack/react-virtual": "^3.14.21",
    "class-variance-authority": "^0.7.1",
    "cn": "0.5.0",
    "dexie": "^4.4.6",
    "flag-icons": "^7.5.0",
    "fuse.js": "^7.5.0",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@cloudflare/workers-types": "^5.20261013.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "1.168.47",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "adm-zip": "^0.6.1",
    "cross-env": "10.1.0",
    "eslint-plugin-better-tailwindcss": "^4.9.0",
    "eslint-plugin-react-doctor": "0.9.17",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "fallow": "^3.33.1",
    "jsdom": "^30.1.3",
    "oxc-transform-react": "^0.153.0",
    "png-to-ico": "^3.0.2",
    "react-doctor": "^0.9.18",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
