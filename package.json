    "build:android:apk": "pnpm cap:android && pnpm cap:version && cd android && .\\gradlew.bat assembleDebug",
    "build:android:aab": "pnpm cap:android && pnpm cap:version && cd android && .\\gradlew.bat bundleRelease",
