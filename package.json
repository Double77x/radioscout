{
  "name": "radioscout",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -b",
    "postbuild": "node scripts/generate-sitemap.js && node scripts/apply-header-policy.js",
    "build:dev": "vite build --mode development",
    "lint": "oxlint .",
    "format": "oxfmt",
    "preview": "wrangler pages dev --port 8788",
    "cap:sync": "npx cap sync",
    "cap:android": "pnpm build && npx cap sync android",
    "cap:open:android": "npx cap open android",
    "cap:version": "node scripts/cap-version.js",
    "ota:publish": "node scripts/publish-ota.mjs",
    "cap:assets": "node scripts/generate-native-assets.mjs",
    "cap:doctor": "npx cap doctor",
    "build:android:apk": "pnpm cap:android && pnpm cap:version && cd android && .\\gradlew.bat assembleDebug",
    "build:android:aab": "pnpm cap:android && pnpm cap:version && cd android && .\\gradlew.bat bundleRelease",
    "test": "vitest run && playwright test",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-updater": "^8.51.15",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/react-start": "1.168.53",
    "@tanstack/react-virtual": "^3.14.12",
    "class-variance-authority": "^0.7.1",
    "cn": "0.3.0",
    "dexie": "^4.4.6",
    "flag-icons": "^7.5.0",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.45.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.38",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "adm-zip": "^0.6.1",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-react-doctor": "0.9.14",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fake-indexeddb": "^6.2.5",
    "fallow": "^3.25.0",
    "jsdom": "^30.0.1",
    "oxfmt": "0.67.0",
    "oxlint": "^1.82.0",
    "png-to-ico": "^3.0.2",
    "react-doctor": "^0.9.14",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.131.1"
  }
}
