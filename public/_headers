# Global security headers and cache control
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.cloudflare.com https://*.cloudflareinsights.com data:; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https:; media-src https: http: blob: data:; connect-src 'self' https://*.cloudflare.com https://*.cloudflareinsights.com https://*.api.radio-browser.info; frame-ancestors 'none';
  Cache-Control: public, max-age=0, must-revalidate

# JS/CSS: 1 year immutable (hashed filenames safe)
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

# CSS: must-revalidate so updates apply instantly
/assets/*.css
  Cache-Control: public, max-age=0, must-revalidate

# Fonts: 1 year
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images/Media: 1 year
/images/*
  Cache-Control: public, max-age=31536000, immutable

# Logo (header mark source for icon generation)
/logo.svg
  Cache-Control: public, max-age=31536000, immutable

/logo-dark.svg
  Cache-Control: public, max-age=31536000, immutable

# Favicons
/favicon.*
  Cache-Control: public, max-age=31536000, immutable

/icon-*
  Cache-Control: public, max-age=31536000, immutable